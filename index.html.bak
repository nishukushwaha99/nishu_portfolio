    <!-- ==========================================================================
         ABOUT ME & INTERACTIVE TERMINAL
         ========================================================================== -->
    <section class="section" id="about">
      <div class="container">
        <div style="text-align: center;">
          <span class="section-tag">01. Profile & Aspirations</span>
          <h2 class="section-title">About Nishu Kushwaha</h2>
          <p class="section-subtitle">Dedicated computer applications scholar with strong analytical foundations, software design skills, and a commitment to technological excellence.</p>
        </div>

        <div class="about-grid">
          <!-- Left: Narrative -->
          <div class="about-text">
            <p>
              I am <strong>Nishu Kushwaha</strong>, born on <strong>05 September 2007</strong> and originally from <strong>Sarna Bhanpur, Dinara (Rohtas, Bihar)</strong>. Currently, I am residing in Delhi NCR while pursuing my <strong>BCA (Bachelor of Computer Applications)</strong> at the esteemed <strong>Shri Ram Group of College, Muzaffarnagar</strong>.
            </p>
            <p>
              With a current <strong>CGPA of 8.36</strong> in my 2nd semester, I take pride in balancing strong theoretical foundations with practical programming mastery. My key technical interests lie in <strong>Data Analytics with Power BI</strong>, relational database architecture using <strong>SQL & DBMS</strong>, and software engineering in <strong>Python, C/C++, and Java</strong>.
            </p>

            <div class="highlight-cards">
              <div class="highlight-card">
                <i class="fa-solid fa-chart-line"></i>
                <h4>Data Analytics & Power BI</h4>
                <p>Interactive business reporting, KPI telemetry, and data visualization.</p>
              </div>
              <div class="highlight-card">
                <i class="fa-solid fa-database"></i>
                <h4>SQL & DBMS Architecture</h4>
                <p>Relational queries, schema normalization, and database optimization.</p>
              </div>
              <div class="highlight-card">
                <i class="fa-solid fa-code"></i>
                <h4>Software Engineering</h4>
                <p>Object-oriented programming in Python, Java, and C/C++.</p>
              </div>
              <div class="highlight-card">
                <i class="fa-solid fa-comments"></i>
                <h4>Communication & Operations</h4>
                <p>Customer handling, professional correspondence, and team collaboration.</p>
              </div>
            </div>
          </div>

          <!-- Right: Interactive CLI Terminal -->
          <div id="terminal-section">
            <div class="terminal-window">
              <div class="terminal-header">
                <div class="terminal-controls">
                  <span class="terminal-dot dot-red"></span>
                  <span class="terminal-dot dot-yellow"></span>
                  <span class="terminal-dot dot-green"></span>
                </div>
                <div class="terminal-title">
                  <i class="fa-solid fa-terminal" style="font-size:0.75rem;"></i>
                  <span>nishu@devbox:~ (bash)</span>
                </div>
                <div class="terminal-quick-cmds">
                  <button class="quick-cmd-btn" data-cmd="education">education</button>
                  <button class="quick-cmd-btn" data-cmd="skills">skills</button>
                  <button class="quick-cmd-btn" data-cmd="biodata">biodata</button>
                  <button class="quick-cmd-btn" data-cmd="contact">contact</button>
                </div>
              </div>

              <div class="terminal-body" id="terminal-body">
                <div class="terminal-output-line">
                  <span style="color:var(--accent-primary);">Nishu Kushwaha Devbox CLI v2.4.0 (SRGC Environment)</span>
                </div>
                <div class="terminal-output-line" style="color:var(--text-dim);">
                  Type <span style="color:var(--accent-primary);">help</span> or click command pills above to inspect Nishu's profile.
                </div>
                <div class="terminal-output-line">
                  <span class="prompt-prefix">nishu@devbox:~$</span> <span style="color:#fff;">whoami</span>
                </div>
                <div class="terminal-output-line" style="color:#cbd5e1;">
                  Nishu Kushwaha — BCA 2nd Year Student (CGPA: 8.36) at Shri Ram Group of College, Delhi NCR.
                </div>
              </div>

              <div class="terminal-header" style="background:#090d16; border-top:1px solid rgba(255,255,255,0.06); border-bottom:none; padding:10px 18px;">
                <div class="terminal-input-row" style="width:100%; margin:0;">
                  <span class="prompt-prefix">nishu@devbox:~$</span>
                  <input type="text" id="terminal-input" class="terminal-input" placeholder="try typing: education, skills, biodata, hobbies, family..." autocomplete="off" spellcheck="false" aria-label="Terminal command input">
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
